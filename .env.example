# Copy to .env (gitignored) and fill in. Never commit real keys.
# One key, many models (DeepSeek/Qwen/Gemini/Claude) — our default route:
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional direct-provider keys (cheaper at scale via native prefix caching):
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# live | record | replay  (cassette discipline from day one)
PUNESIM_LLM=record

# Model slugs (verify current names at openrouter.ai/models and pin here):
PUNESIM_MODEL_WORKHORSE=deepseek/deepseek-chat
PUNESIM_MODEL_FLASH=deepseek/deepseek-chat
PUNESIM_MODEL_PREMIUM=anthropic/claude-sonnet-4.5

# spotlight = attention top-k households fire LLM scenes (default)
# all       = every household fires (LLM-for-everyone dial; cost scales linearly)
SCENE_GATE_MODE=spotlight
PUNESIM_RUN_SEED=108
